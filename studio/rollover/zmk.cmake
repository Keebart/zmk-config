# Runtime rollover is central-only; peripheral radios and storage are unchanged.
if(CONFIG_KEEBART_STUDIO)
  set(ks_rollover_dir "${CMAKE_CURRENT_LIST_DIR}/../rollover")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${ks_rollover_dir}/zmk_patch.py")
  foreach(pair "hid|hid" "usb_hid|usb" "hog|hog")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 file)
    list(GET parts 1 kind)
    set(original "${APPLICATION_SOURCE_DIR}/src/${file}.c")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/ks_${file}.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
    execute_process(COMMAND ${PYTHON_EXECUTABLE} "${ks_rollover_dir}/zmk_patch.py"
      "${kind}" "${original}" "${generated}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Studio rollover adapter failed for ${file}")
    endif()
    set_property(GLOBAL PROPERTY KEEBART_ROLLOVER_${file} "${generated}")
  endforeach()
  # Retain the already generated eight-button mouse descriptor.
  set(header "${CMAKE_CURRENT_BINARY_DIR}/pointer_include/zmk/hid.h")
  execute_process(COMMAND ${PYTHON_EXECUTABLE} "${ks_rollover_dir}/zmk_patch.py"
    header "${header}" "${header}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Studio rollover descriptor failed")
  endif()
  # app/include otherwise precedes interface includes, silently hiding this header.
  target_include_directories(app BEFORE PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/pointer_include")
  function(keebart_rollover_sources)
    get_target_property(sources app SOURCES)
    foreach(file hid usb_hid hog)
      set(originals ${sources})
      list(FILTER originals INCLUDE REGEX "(^|/)src/${file}\\.c$")
      list(LENGTH originals count)
      if(NOT count EQUAL 1)
        message(FATAL_ERROR "Studio expects exactly one pinned ${file} source")
      endif()
      list(REMOVE_ITEM sources ${originals})
      get_property(replacement GLOBAL PROPERTY KEEBART_ROLLOVER_${file})
      list(APPEND sources "${replacement}")
    endforeach()
    set_property(TARGET app PROPERTY SOURCES ${sources})
  endfunction()
  cmake_language(DEFER DIRECTORY ${APPLICATION_SOURCE_DIR} CALL keebart_rollover_sources)

  # Boot protocol support must not introduce unused 1 kHz USB frame events.
  # Patch only the Studio central build, leaving upstream and peripherals alone.
  set(original "${ZEPHYR_BASE}/drivers/usb/device/usb_dc_nrfx.c")
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/ks_usb_dc_nrfx.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
  execute_process(COMMAND ${PYTHON_EXECUTABLE} "${ks_rollover_dir}/zmk_patch.py"
    nrfx "${original}" "${generated}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Studio USB frame-event adapter failed")
  endif()
  set_property(GLOBAL PROPERTY KEEBART_ROLLOVER_USB_DRIVER "${generated}")
  function(keebart_rollover_usb_driver)
    get_target_property(sources drivers__usb__device SOURCES)
    set(originals ${sources})
    list(FILTER originals INCLUDE REGEX "(^|/)usb_dc_nrfx\\.c$")
    list(LENGTH originals count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "Studio expects exactly one pinned nRF USB driver")
    endif()
    list(REMOVE_ITEM sources ${originals})
    get_property(replacement GLOBAL PROPERTY KEEBART_ROLLOVER_USB_DRIVER)
    list(APPEND sources "${replacement}")
    set_property(TARGET drivers__usb__device PROPERTY SOURCES "${sources}")
  endfunction()
  cmake_language(DEFER DIRECTORY ${APPLICATION_SOURCE_DIR} CALL keebart_rollover_usb_driver)
endif()
