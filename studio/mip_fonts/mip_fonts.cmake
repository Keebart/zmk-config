# Swap upstream 4-bpp LVGL Montserrat fonts for pixel-exact 1-bpp Sharp MiP fonts
# without modifying upstream LVGL or Sharp MiP widget sources.
function(keebart_studio_apply_mip_fonts)
  if(NOT TARGET modules__lvgl)
    return()
  endif()
  get_target_property(_lvgl_sources modules__lvgl SOURCES)
  if(NOT _lvgl_sources)
    return()
  endif()
  set(_updated "")
  set(_replaced 0)
  foreach(_src IN LISTS _lvgl_sources)
    get_filename_component(_name "${_src}" NAME)
    if(_name MATCHES "^lv_font_montserrat_(12|14|16|18)\\.c$" AND EXISTS "${KEEBART_STUDIO_MIP_FONTS_DIR}/${_name}")
      list(APPEND _updated "${KEEBART_STUDIO_MIP_FONTS_DIR}/${_name}")
      math(EXPR _replaced "${_replaced} + 1")
    else()
      list(APPEND _updated "${_src}")
    endif()
  endforeach()
  if(_replaced GREATER 0)
    set_target_properties(modules__lvgl PROPERTIES SOURCES "${_updated}")
  endif()
endfunction()

if(CONFIG_ZMK_DISPLAY)
  set(KEEBART_STUDIO_MIP_FONTS_DIR "${CMAKE_CURRENT_LIST_DIR}")
  cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL keebart_studio_apply_mip_fonts)
endif()
