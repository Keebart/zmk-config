set(ks_led_power_source "${CMAKE_CURRENT_BINARY_DIR}/led_power.c")
set(ks_led_power_original "${APPLICATION_SOURCE_DIR}/src/ext_power_generic.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ks_led_power_original}" "${CMAKE_CURRENT_LIST_DIR}/led_power.py")
execute_process(COMMAND ${PYTHON_EXECUTABLE} "${CMAKE_CURRENT_LIST_DIR}/led_power.py" "${ks_led_power_original}" "${ks_led_power_source}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Studio LED power adapter could not be applied")
endif()
set_property(GLOBAL PROPERTY KEEBART_LED_POWER_SOURCE "${ks_led_power_source}")
function(keebart_led_power_source)
  get_target_property(sources app SOURCES)
  set(originals ${sources})
  list(FILTER originals INCLUDE REGEX "(^|/)src/ext_power_generic\\.c$")
  list(LENGTH originals count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Studio expects exactly one external power driver")
  endif()
  list(REMOVE_ITEM sources ${originals})
  get_property(replacement GLOBAL PROPERTY KEEBART_LED_POWER_SOURCE)
  list(APPEND sources "${replacement}")
  set_property(TARGET app PROPERTY SOURCES ${sources})
endfunction()
cmake_language(DEFER DIRECTORY ${APPLICATION_SOURCE_DIR} CALL keebart_led_power_source)
