if BOARD_CORNE_V2_RIGHT

config ZMK_KEYBOARD_NAME
	default "Corne NumNav"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_CORNE_V2_RIGHT

if BOARD_CORNE_V2_LEFT || BOARD_CORNE_V2_RIGHT

config BOARD
    default "corne_v2"

config ZMK_SPLIT
    default y

if USB

config USB_NRFX
	default y

config USB_DEVICE_STACK
	default y

endif # USB

config BT_CTLR
	default BT

config I2C
	default y

config ZMK_MAX17048
    default y

endif # BOARD_CORNE_V2_LEFT || BOARD_CORNE_V2_RIGHT
